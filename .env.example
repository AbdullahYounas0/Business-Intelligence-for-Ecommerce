# ============================================================
#  E-Commerce Intelligence Hub — Environment Configuration
#  Copy this file to .env and fill in your real values.
#  NEVER commit .env to version control.
# ============================================================

# ── Google Cloud / BigQuery ──────────────────────────────────
# GCP project ID (found in Google Cloud Console)
GOOGLE_CLOUD_PROJECT=your-gcp-project-id

# BigQuery dataset names (create these before running)
BIGQUERY_DATASET_RAW=ecom_raw
BIGQUERY_DATASET_FEATURES=ecom_features
BIGQUERY_DATASET_AUDIT=ecom_audit

# Optional: override dataset location (e.g. US, EU)
# BIGQUERY_LOCATION=US

# ── OpenAI ───────────────────────────────────────────────────
# GPT-4o API key — https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-your-openai-api-key-here

# ── Slack Webhooks ───────────────────────────────────────────
# Create Incoming Webhooks at https://api.slack.com/apps
SLACK_WEBHOOK_RETENTION=https://hooks.slack.com/services/YOUR/RETENTION/WEBHOOK
SLACK_WEBHOOK_INVENTORY=https://hooks.slack.com/services/YOUR/INVENTORY/WEBHOOK

# ── Email (Resend) ───────────────────────────────────────────
# Resend API key — https://resend.com/api-keys
RESEND_API_KEY=re_your-resend-api-key-here

# Recipient for the Monday morning digest email
DIGEST_EMAIL_TO=ops-team@yourcompany.com

# ── Business Thresholds ──────────────────────────────────────
# RFM score below this = customer flagged as at-risk
CHURN_RFM_THRESHOLD=30

# Units available below this = low-stock alert triggered
INVENTORY_REORDER_THRESHOLD=10

# Orders not updated for this many hours = stalled order alert
STALLED_ORDER_HOURS=24

# API rate limiting (requests per minute per IP)
MAX_REQUESTS_PER_MINUTE=20
